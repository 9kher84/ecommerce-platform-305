{
  "name": "Sovereign Platform MCP Server",
  "version": "1.0.0",
  "description": "MCP server for agent-to-agent negotiation and data exchange",
  "endpoint": "https://sovereign.com/mcp",
  "capabilities": [
    "search_products",
    "get_supplier_info",
    "get_buyer_requests",
