# ========================================================================
# PRODUCTION ENVIRONMENT VARIABLES - EXAMPLE
# ========================================================================
# ⚠️ CRITICAL: This is an EXAMPLE file. DO NOT use these values in production!
# ⚠️ Copy this file to .env.prod and change ALL secret values!

# ========================================================================
# APPLICATION
# ========================================================================
NODE_ENV=production
PORT=5000

# ========================================================================
# DATABASE (PostgreSQL)
# ========================================================================
# ⚠️ CHANGE THESE VALUES IN PRODUCTION!
DB_HOST=postgres
DB_PORT=5432
DB_USER=ecommerce_prod_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_32_CHARS
DB_DATABASE=ecommerce_prod_db

# Read Replicas (optional - for load balancing)
# Example: DB_READ_HOSTS=read1.yourdb.com,read2.yourdb.com,read3.yourdb.com
DB_READ_HOSTS=

# ========================================================================
# REDIS (Caching & Sessions)
# ========================================================================
# ⚠️ CHANGE THIS PASSWORD IN PRODUCTION!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ========================================================================
# JWT AUTHENTICATION
# ========================================================================
# ⚠️ CRITICAL: Generate a strong random secret!
# Use: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_GENERATED_BY_OPENSSL
JWT_EXPIRE=30d

# ========================================================================
# FRONTEND URL (for CORS)
# ========================================================================
FRONTEND_URL=https://yourdomain.com

# ========================================================================
# PAYMENT GATEWAY (LIVE MODE)
# ========================================================================
# ⚠️ CRITICAL: Use LIVE credentials, not TEST!
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_API_KEY=live_pk_YOUR_LIVE_PUBLIC_KEY
PAYMENT_API_SECRET=live_sk_YOUR_LIVE_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ========================================================================
# CDN / FILE STORAGE (AWS S3 or Cloudflare R2)
# ========================================================================
# ⚠️ Required for production to serve attachments globally

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=ecommerce-platform-attachments

# CDN URL (CloudFront or Cloudflare)
CDN_URL=https://cdn.yourdomain.com

# Alternative: Cloudflare R2
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=ecommerce-attachments

# ========================================================================
# EMAIL SERVICE (SMTP)
# ========================================================================
# For sending notifications, password resets, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_NAME=E-commerce Platform
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ========================================================================
# MONITORING & ERROR TRACKING
# ========================================================================
# Sentry for error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Logging level
LOG_LEVEL=info

# ========================================================================
# SSL/TLS CERTIFICATES
# ========================================================================
# Let's Encrypt email for SSL certificate renewal
SSL_EMAIL=admin@yourdomain.com
SSL_DOMAIN=api.yourdomain.com

# ========================================================================
# RATE LIMITING
# ========================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================================================
# SECURITY HEADERS
# ========================================================================
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'

# ========================================================================
# BACKUP CONFIGURATION
# ========================================================================
# S3 bucket for database backups
BACKUP_S3_BUCKET=ecommerce-platform-backups
BACKUP_RETENTION_DAYS=30

# ========================================================================
# PRODUCTION CHECKLIST
# ========================================================================
# Before deploying to production, ensure you have:
# 
# ✅ Changed ALL passwords and secrets above
# ✅ Generated a strong JWT_SECRET using: openssl rand -base64 64
# ✅ Set up SSL/TLS certificates (Let's Encrypt recommended)
# ✅ Configured CDN/S3 for file storage
# ✅ Set up payment gateway with LIVE credentials
# ✅ Configured SMTP for email notifications
# ✅ Set up Sentry or similar for error tracking
# ✅ Configured database backups
# ✅ Set up monitoring (Prometheus, Grafana)
# ✅ Reviewed and tested all environment variables
# ✅ Set up firewall rules on production server
# ✅ Configured domain DNS records
# ✅ Tested the entire deployment in staging environment first
#
# ⚠️ NEVER commit .env.prod to version control!
# ⚠️ Use secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
