# Environment Variables for E-commerce Platform Backend
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ecommerce_db

# Database Read Replicas (optional - for load balancing)
DB_READ_HOSTS=

# JWT Configuration
# ⚠️ CRITICAL: Generate a secure random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Session Security
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here_minimum_64_characters

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# Frontend URL
CLIENT_URL=http://localhost:3000

# Backend URL (for webhooks)
APP_URL=http://localhost:5000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (for notifications)
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email-account
EMAIL_PASS=your-email-password
APP_NAME=منصة العروض

# Payment System Configuration
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_64_characters_hex

# Payment Gateway Credentials (to be added when integrating)
# MADA_MERCHANT_ID=
# MADA_API_KEY=
# MADA_WEBHOOK_SECRET=
# STC_PAY_MERCHANT_ID=
# STC_PAY_API_KEY=
# STC_PAY_WEBHOOK_SECRET=

# Database Security (for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Invoice System Settings
INVOICE_DUE_DAYS=30
INVOICE_AUTO_CANCEL_DAYS=45
INVOICE_OVERDUE_SANCTION=shadow_restriction
