    notes: {
        type: DataTypes.TEXT,
        allowNull: true
    },
    deliveryProof: {
        type: DataTypes.JSONB,
        allowNull: true
    },
    invoiceData: {
        type: DataTypes.JSONB,
        allowNull: true,
        comment: 'Snapshot of buyer/seller info at deal time (Electronic Invoice)'
    }
}, {
    paranoid: true,
    timestamps: true
});

// Rating Model
const Rating = sequelize.define('Rating', {
