{
  "name": "b2b-market-hub",
  "version": "2.0.0",
  "description": "Internal B2B procurement platform",
  "author": "dev-team <dev@example.com>",
  "overrides": {
    "qs": "^6.14.1"
  },
  "main": "server.js",
  "scripts": {
    "build": "npx sequelize-cli db:migrate --env production",
    "start": "node scripts/pre-flight-check.js && node server.js",
    "start:render": "node server.js",
    "dev": "node scripts/pre-flight-check.js && nodemon server.js",
    "clean-dev": "npm run kill-port && npm run dev",
    "kill-port": "powershell.exe -Command \"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "db:sync": "node sync_db.js",
    "db:migrate": "node sync_db.js",
    "render:bootstrap": "node scripts/render-bootstrap.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "install-safe": "npm ci",
    "load-test": "node scripts/loadTest.js",
    "load-test:all": "node scripts/loadTest.js all",
    "load-test:health": "node scripts/loadTest.js health",
    "db:analyze": "node scripts/analyzeDatabase.js",
    "perf:baseline": "node scripts/baselineTest.js",
    "test:security": "jest ../tests/final-red-team.test.js --forceExit --verbose",
    "lint:security": "eslint . --plugin security --rule 'security/detect-object-injection: warn'",
    "security-gate": "node scripts/audit-gate.js"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express4": "^1.1.2",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-list-endpoints": "^7.1.1",
    "express-rate-limit": "^6.11.2",
    "graphql": "^16.12.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.22",
    "morgan": "^1.10.0",
    "msgpack-lite": "^0.1.26",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-vault": "^0.10.9",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "qs": "^6.14.1",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.10.0",
    "sequelize": "^6.32.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "ssrf-req-filter": "^1.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "8.3.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.20.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jest": "^29.5.0",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
