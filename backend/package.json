{
  "name": "ecommerce-platform-backend",
  "version": "2.0.0",
  "description": "E-commerce platform backend with payment system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clean-dev": "npm run kill-port && npm run dev",
    "kill-port": "powershell.exe -Command \"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "install-safe": "npm ci",
    "load-test": "node scripts/loadTest.js",
    "load-test:all": "node scripts/loadTest.js all",
    "load-test:health": "node scripts/loadTest.js health",
    "db:analyze": "node scripts/analyzeDatabase.js",
    "perf:baseline": "node scripts/baselineTest.js",
    "lint:security": "eslint . --plugin security --rule 'security/detect-object-injection: warn'"
  },
  "dependencies": {
    "@apollo/server": "^5.2.0",
    "@as-integrations/express4": "^1.1.2",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.0.0",
    "casl": "^0.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^6.11.2",
    "graphql": "^16.12.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-vault": "^0.10.9",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.10.0",
    "sequelize": "^6.32.0",
    "socket.io": "^4.8.1",
    "ssrf-req-filter": "^1.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^6.0.0",
    "uuid": "8.3.2",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}