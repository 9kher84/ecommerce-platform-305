# 🛡️ SOVEREIGN ENVIRONMENT VARIABLES (EXAMPLE)
# SSC/DOCKER-DEPLOY-2026

# Application
NODE_ENV=production
PORT=5000
JWT_SECRET=change_this_to_a_secure_random_string_in_production
OWNER_ID=uuid-of-the-sovereign-owner

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=sovereign_db
DB_USER=sovereign_user
DB_PASSWORD=sovereign_secure_password

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Security Vault (Optional for Docker Demo, Required for Prod)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root_token_example
