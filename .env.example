# ============================================================
# 🌏 GLOBAL CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ============================================================
# 🗄️ DATABASE (POSTGRES)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=sovereign_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# ============================================================
# 🚀 REDIS (REQUIRED FOR RATE LIMIT & JOBS)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
DISABLE_REDIS=false

# ============================================================
# 🛡️ SECURITY & AUTH
# ============================================================
JWT_SECRET=generate_a_long_random_string_here
JWT_EXPIRES_IN=7d
SIGNATURE_KEY=your_hmac_signature_key

# SOVEREIGN EMERGENCY LOCK
OWNER_ID=your_owner_uuid_here
OWNER_IP=127.0.0.1
OWNER_PANEL_ENABLED=true
SYSTEM_STATUS=OPERATIONAL
OWNER_BOOTSTRAP_ENABLED=true

# ============================================================
# 💳 PAYMENT GATEWAY (MADA / STC_PAY)
# ============================================================
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here
MADA_MERCHANT_ID=
MADA_API_KEY=
MADA_WEBHOOK_SECRET=

# ============================================================
# 📧 EMAIL (SMTP)
# ============================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sovereign-platform.sa

# ============================================================
# ☁️ CLOUD STORAGE (OPTIONAL)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ============================================================
# ?? COMMISSIONS
# ============================================================
PLATFORM_COMMISSION_PERCENTAGE=2.0
SUPERVISOR_COMMISSION_PERCENTAGE=0.5

# ============================================================
# ?? OPENCLAW BRIDGE
# ============================================================
OPENCLAW_WEBHOOK_URL=http://backend:3000/api/agents/webhook
OPENCLAW_TOKEN=
