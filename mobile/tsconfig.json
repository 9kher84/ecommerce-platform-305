{
    "extends": "@tsconfig/react-native/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "baseUrl": "./src",
        "paths": {
            "@app/*": [
                "app/*"
            ],
            "@presentation/*": [
                "presentation/*"
            ],
            "@domain/*": [
                "domain/*"
            ],
            "@data/*": [
                "data/*"
            ],
            "@core/*": [
                "core/*"
            ]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./src/types"
        ],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*",
        "App.tsx"
    ],
    "exclude": [
        "node_modules",
        "android",
        "ios",
        "build"
    ]
}